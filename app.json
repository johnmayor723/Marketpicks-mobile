{
  "expo": {
    "name": "Market Picks",
    "slug": "MarketPicks",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/android-icon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/android-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marketpicks",
      "version": "2.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby places."
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "INTERNET"
      ],
      "package": "com.marketpicks"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
        }
